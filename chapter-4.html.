<script>
const progressBar = document.getElementById("progressBar");
const story = document.querySelector(".story");

const verticalBtn = document.getElementById("verticalBtn");
const horizontalBtn = document.getElementById("horizontalBtn");

const previousPageBtn = document.getElementById("previousPage");
const nextPageBtn = document.getElementById("nextPage");
const pageNumber = document.getElementById("pageNumber");

const originalStoryChildren = Array.from(story.children);

let pages = [];
let currentPage = 0;

function updateReadingProgress() {
  if (document.body.classList.contains("horizontal-reading")) {
    const progress = pages.length > 1
      ? (currentPage / (pages.length - 1)) * 100
      : 0;

    progressBar.style.width = progress + "%";
  } else {
    const storyTop = story.getBoundingClientRect().top + window.scrollY;
    const maxScroll = story.scrollHeight - window.innerHeight;

    const progress = maxScroll > 0
      ? ((window.scrollY - storyTop) / maxScroll) * 100
      : 0;

    progressBar.style.width =
      Math.min(100, Math.max(0, progress)) + "%";
  }
}

function createPage() {
  const page = document.createElement("div");

  page.className = "reader-page";
  page.style.width = "100%";
  page.style.height = "100%";
  page.style.overflow = "hidden";
  page.style.boxSizing = "border-box";
  page.style.position = "absolute";
  page.style.top = "0";
  page.style.left = "0";

  story.appendChild(page);
  pages.push(page);

  return page;
}

function buildPages() {
  const oldPage = currentPage;

  story.replaceChildren();
  pages = [];

  let page = createPage();

  originalStoryChildren.forEach(function (element) {
    page.appendChild(element);

    if (
      page.scrollHeight > page.clientHeight + 2 &&
      page.children.length > 1
    ) {
      page.removeChild(element);

      page = createPage();
      page.appendChild(element);
    }
  });

  currentPage = Math.min(oldPage, pages.length - 1);
  showPage(currentPage);
}

function showPage(number) {
  if (pages.length === 0) return;

  currentPage = Math.max(0, Math.min(number, pages.length - 1));

  pages.forEach(function (page, index) {
    page.style.display = index === currentPage ? "block" : "none";
  });

  pageNumber.textContent =
    (currentPage + 1) + " / " + pages.length;

  previousPageBtn.disabled = currentPage === 0;
  nextPageBtn.disabled = currentPage === pages.length - 1;

  updateReadingProgress();
}

function restoreVerticalReading() {
  story.replaceChildren(...originalStoryChildren);
  pages = [];
  currentPage = 0;

  progressBar.style.width = "0%";
}

verticalBtn.addEventListener("click", function () {
  document.body.classList.remove("horizontal-reading");

  restoreVerticalReading();

  verticalBtn.classList.add("active");
  horizontalBtn.classList.remove("active");

  updateReadingProgress();
});

horizontalBtn.addEventListener("click", function () {
  document.body.classList.add("horizontal-reading");

  horizontalBtn.classList.add("active");
  verticalBtn.classList.remove("active");

  buildPages();
});

previousPageBtn.addEventListener("click", function () {
  showPage(currentPage - 1);
});

nextPageBtn.addEventListener("click", function () {
  showPage(currentPage + 1);
});

/* SWIPE TO TURN PAGES */

let touchStartX = 0;

story.addEventListener("touchstart", function (event) {
  if (!document.body.classList.contains("horizontal-reading")) return;

  touchStartX = event.changedTouches[0].screenX;
});

story.addEventListener("touchend", function (event) {
  if (!document.body.classList.contains("horizontal-reading")) return;

  const touchEndX = event.changedTouches[0].screenX;
  const difference = touchStartX - touchEndX;

  if (difference > 50) {
    showPage(currentPage + 1);
  } else if (difference < -50) {
    showPage(currentPage - 1);
  }
});

/* READING THEMES */

const midnightBtn = document.getElementById("midnightBtn");
const paperBtn = document.getElementById("paperBtn");
const sepiaBtn = document.getElementById("sepiaBtn");

midnightBtn.addEventListener("click", function () {
  document.body.classList.remove("theme-paper", "theme-sepia");
  document.body.classList.add("theme-midnight");
});

paperBtn.addEventListener("click", function () {
  document.body.classList.remove("theme-midnight", "theme-sepia");
  document.body.classList.add("theme-paper");
});

sepiaBtn.addEventListener("click", function () {
  document.body.classList.remove("theme-midnight", "theme-sepia");
  document.body.classList.add("theme-sepia");
});

/* FONT SIZE CONTROLS */

const storyParagraphs = document.querySelectorAll(".story p");

const increaseFont = document.getElementById("increaseFont");
const decreaseFont = document.getElementById("decreaseFont");

let currentFontSize = 16;

function applyFontSize() {
  storyParagraphs.forEach(function (paragraph) {
    paragraph.style.fontSize = currentFontSize + "px";
  });

  if (document.body.classList.contains("horizontal-reading")) {
    buildPages();
  }
}

increaseFont.addEventListener("click", function () {
  if (currentFontSize < 26) {
    currentFontSize += 1;
    applyFontSize();
  }
});

decreaseFont.addEventListener("click", function () {
  if (currentFontSize > 12) {
    currentFontSize -= 1;
    applyFontSize();
  }
});

window.addEventListener("scroll", updateReadingProgress);
  /* DISCOURAGE COPYING */

story.addEventListener("contextmenu", function (event) {
  event.preventDefault();
});

document.addEventListener("copy", function (event) {
  const selection = window.getSelection();

  if (
    selection &&
    selection.anchorNode &&
    story.contains(selection.anchorNode)
  ) {
    event.preventDefault();
  }
});
  document.addEventListener("keydown", function (event) {
  const selection = window.getSelection();

  if (
    (event.ctrlKey || event.metaKey) &&
    event.key.toLowerCase() === "c" &&
    selection &&
    selection.anchorNode &&
    story.contains(selection.anchorNode)
  ) {
    event.preventDefault();
  }
});
</script>

